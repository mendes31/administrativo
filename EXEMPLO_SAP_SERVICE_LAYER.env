# ═══════════════════════════════════════════════════════════════
# CONFIGURAÇÃO SAP BUSINESS ONE - SERVICE LAYER
# ═══════════════════════════════════════════════════════════════

# URL da Service Layer (inclua porta e versão da API)
# Formato: https://[servidor]:[porta]/b1s/v1
# Porta padrão: 50000 (HTTPS)
SAP_SL_URL=https://192.168.1.100:50000/b1s/v1

# Credenciais do SAP Business One
SAP_SL_USERNAME=manager
SAP_SL_PASSWORD=sua_senha_aqui

# Nome do banco de dados da empresa no SAP
# Exemplo: SBODEMOUS (banco de demonstração)
#          EMPRESA_PRODUCAO (seu banco de produção)
SAP_SL_COMPANY=SBODEMOUS

# ═══════════════════════════════════════════════════════════════
# INSTRUÇÕES:
# ═══════════════════════════════════════════════════════════════
#
# 1. Copie estas linhas para o seu arquivo .env principal
#
# 2. Ajuste os valores:
#    - SAP_SL_URL: IP/hostname do servidor SAP + porta
#    - SAP_SL_USERNAME: usuário com permissão de consulta
#    - SAP_SL_PASSWORD: senha do usuário
#    - SAP_SL_COMPANY: nome do banco de dados da empresa
#
# 3. Teste a conexão:
#    php scripts/test_sap_service_layer.php
#
# 4. Se funcionar, você verá:
#    ✅ Login realizado com sucesso!
#    ✅ Query executada com sucesso!
#
# ═══════════════════════════════════════════════════════════════
# OBSERVAÇÕES:
# ═══════════════════════════════════════════════════════════════
#
# • A Service Layer usa HTTPS por padrão (porta 50000)
# • Certifique-se que o servidor SAP está acessível da rede
# • O usuário precisa ter permissão para executar queries
# • Não precisa instalar drivers ODBC/HDBODBC!
#
# ═══════════════════════════════════════════════════════════════

