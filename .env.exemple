# Informações do projeto
APP_NAME=Tiaraju
APP_VERSION=1.0.0
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt-BR
APP_LOGS=Sim
APP_ENV=development

# URL do projeto
# URL_ADM=http://localhost/administrativo/
URL_ADM=http://192.168.3.14/administrativo/
# URL pública do Canal de Denúncias (raiz do site, sem /administrativo/)
# URL_CANAL_DENUNCIA=http://localhost/canaldenuncia/

# Importação PDF de folha (muitas páginas): memória PHP. Em produção aumente também
# fastcgi_read_timeout / Timeout no proxy — ver docs/COMANDOS_SERVIDOR_SSH.md
# PAYROLL_IMPORT_MEMORY_LIMIT=512M

# Termos informativos do rodapé (LGPD → tipo Site/Portal; busca parcial no título)
LGPD_TERMO_USO_TITULO="Termos de Uso"
LGPD_POLITICA_PRIVACIDADE_TITULO="Política de Privacidade"
# Canal público LGPD (sem login): /lgpd
# LGPD_EMPRESA_NOME="Grupo Tiaraju"
# LGPD_DPO_NOME=
# LGPD_DPO_EMAIL=
# LGPD_DPO_TELEFONE=
# PDFs opcionais (cartões só aparecem se o ficheiro existir)
# LGPD_CARTILHA_PATH=storage/lgpd/publico/cartilha.pdf
# LGPD_CARTA_COMPROMISSO_PATH=storage/lgpd/publico/carta-compromisso.pdf

# (Opcional) Token para cron externo de informativos agendados
# A ativação já ocorre automaticamente no login, dashboard e listagem de informativos.
# Só configure se precisar de ativação fora do horário de acesso dos usuários.
# CRON_INFORMATIVOS_TOKEN=

# E-mail do administrador
EMAIL_ADM=
EMAIL_TI=
NAME_EMAIL_TI=

# Preflight CLI de comunicações de entrevista (sem SMTP).
# Só permite --apply em scripts/rh_entrevista_comunicacoes_preflight.php quando true.
# RH_ENTREVISTA_PREFLIGHT_APPLY=false

# Worker SMTP de entrevistas: o envio é controlado pelo interruptor
# "Envio automático de comunicações de entrevista" na tela Configuração de E-mail
# (coluna adms_email_config.rh_entrevista_send_enabled) + argumento --send.
# Em ambiente não produtivo, também exige test_recipient na configuração de e-mail.

# Credenciais do banco de dados
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=

# Canal de Denúncias
# Segredo de envelopamento da chave de dados gravada no banco (Modelo B). Mín. 32 caracteres.
# Gere com: php -r "echo bin2hex(random_bytes(32));"
# Quase nunca muda. Backup deste .env deve ficar SEPARADO do dump do banco.
# Sem este valor, não é possível abrir a chave envelopada nem guardar/rotacionar DEK pela Configuração.
WHISTLEBLOWING_KEY_WRAP_SECRET=
# Opcional: DEK só no .env (alternativa/fallback à chave da Configuração)
# WHISTLEBLOWING_ENCRYPTION_KEY=
# CRON_WHISTLEBLOWING_TOKEN=

# Credenciais do banco de dados
# DB_HOST=
# DB_NAME=
# DB_USER=
# DB_PASS=
# DB_PORT=

# Credenciais do servidor de email (opcional)
# MAIL_HOST=smtp.gmail.com
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_PORT=587
# MAIL_ENCRYPTI=TLS

# Chat interno — piloto local (opcional)
# Na tela Configuração API MCP use base_url = local:internal (sem servidor externo).
#
# LLM para roteamento/análise (INTERNAL_CHAT_LLM=auto|openai|anthropic|ollama):
# INTERNAL_CHAT_LLM=auto
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
#
# Ollama gratuito no PC (fallback se não houver chave de API):
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# O modelo ativo também pode ser escolhido em Administração → Configurações → Assistente MCP
# (sem editar o .env). Fallbacks opcionais na mesma tela ou:
# OLLAMA_MODELS_FALLBACK=llama3.2,qwen:4b
# Resumo analítico após headcount/relatório (1=sim, 0=não):
# INTERNAL_CHAT_ANALYZE=1
# OLLAMA_ANALYZE=1
