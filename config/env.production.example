# ============================================
# CONFIGURAÇÕES DE PRODUÇÃO - EXEMPLO
# ============================================
# 
# ⚠️ INSTRUÇÕES:
# 1. Copie este arquivo para a raiz como .env
# 2. Preencha com os valores corretos de produção
# 3. NUNCA commite o .env no Git
# 4. Mantenha em local seguro
#
# ============================================

# BANCO MySQL (Hospedagem)
DB_HOST=host-mysql.hospedagem.com
DB_NAME=banco_producao
DB_USER=usuario_prod
DB_PASS=SENHA_FORTE_MYSQL

# SAP HANA (via VPN/Túnel)
SAP_HANA_HOST=192.168.X.X
SAP_HANA_PORT=30015
SAP_HANA_USER=usuario_readonly
SAP_HANA_PASSWORD=SENHA_FORTE_SAP
SAP_HANA_SCHEMA=SBO_PRODUCAO

# SAP API de relatórios (HTTP)
SAP_REPORT_API_URL=https://02eb453e3bb4.ngrok-free.app/query
SAP_REPORT_API_TIMEOUT=30

# URLs
URL_ADM=https://seu-dominio.com.br/administrativo/

# Ambiente
APP_ENV=production
APP_DEBUG=false

# Worker SMTP de entrevistas: o envio é controlado pelo interruptor
# "Envio automático de comunicações de entrevista" na tela Configuração de E-mail
# (adms_email_config.rh_entrevista_send_enabled). Mantenha desligado até validar
# migration, preflight e dry-run. O envio também exige executar o script com --send.

