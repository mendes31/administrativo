# Dependências
/vendor/

# Ambiente
.env

# Cache e arquivos gerados
storage/cache/
app/storage/cache/
storage/logs/
app/storage/logs/

# Logs da aplicação (só na raiz — não usar "logs/" solto: ignoraria app/adms/Views/logs e Controllers/logs)
/logs/
/app/logs/

# Cache JSON (relatórios, previews, dashboards)
storage/cache/**/*.json
app/storage/cache/**/*.json

# Arquivos temporários de debug
app/adms/Controllers/serveFile/*.txt

# Manter diretório logs vazio (opcional)
!/logs/.empty

# Folhas de pagamento (PDF) — dados sensíveis (LGPD)
storage/private/payroll/*
!storage/private/payroll/.gitkeep
storage/private/payroll/signed_bundles/**

# Arquivos gerados em runtime (SST, LGPD) — não versionar
storage/sst/epi_fichas/**
!storage/sst/epi_fichas/.gitkeep
storage/sst/attachments/**
!storage/sst/attachments/.gitkeep
storage/lgpd/consentimentos/**
!storage/lgpd/consentimentos/.gitkeep

# qpdf portátil (opcional — binário grande; copiar manualmente em cada servidor)
/bin/qpdf.exe
/bin/qpdf
/bin/*.exe
/bin/*.dll

# Bibliotecas locais do qpdf em Linux (manter fora do Git/deploy automático)
/lib/

# Dados brutos CID-10 DATASUS (importar localmente via seed)
database/seeds/data/CID10CSV.zip
database/seeds/data/cid10_raw/


